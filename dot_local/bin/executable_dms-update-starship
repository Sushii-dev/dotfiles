#!/usr/bin/env python3
"""Read DMS colors and generate starship.toml, fastfetch config, and fish colors from templates."""
import json
import re
from pathlib import Path

colors_file = Path.home() / ".cache/DankMaterialShell/dms-colors.json"

with open(colors_file) as f:
    data = json.load(f)

d16 = data["dank16"]
mat = data["colors"]["dark"]


def resolve_placeholder(match):
    key = match.group(1)
    parts = key.split(".")
    fmt = parts[-1]  # "hex" or "hex_stripped"

    if parts[-2] != "default":
        return match.group(0)

    color_val = None
    if parts[0] == "colors":
        color_name = parts[1]
        if color_name in mat:
            color_val = mat[color_name]
    elif parts[0] == "dank16":
        color_key = parts[1]
        if color_key in d16:
            color_val = d16[color_key]["default"]

    if color_val is None:
        return match.group(0)

    if fmt == "hex":
        return color_val
    elif fmt == "hex_stripped":
        return color_val.lstrip("#")

    return match.group(0)


def process_template(template_path, output_path):
    """Process a single template file, resolving color placeholders."""
    with open(template_path) as f:
        content = f.read()

    content = re.sub(r"\{\{([^}]+)\}\}", resolve_placeholder, content)

    unresolved = re.findall(r"\{\{[^}]+\}\}", content)
    if unresolved:
        print(f"WARNING: {len(unresolved)} unresolved variable(s) in {output_path.name}:")
        for var in set(unresolved):
            print(f"  - {var}")

    with open(output_path, "w") as f:
        f.write(content)

    print(f"Generated {output_path}")


# --- Starship ---
templates_dir = Path.home() / ".config/matugen/templates"
process_template(templates_dir / "starship.toml", Path.home() / ".config/starship.toml")

# --- Fastfetch ---
fastfetch_template = templates_dir / "fastfetch.jsonc"
if fastfetch_template.exists():
    process_template(fastfetch_template, Path.home() / ".config/fastfetch/config.jsonc")

# --- Fish colors ---
def h(color):
    return color.lstrip("#")

fish_colors = f"""# Auto-generated from DMS colors — do not edit manually
set -g fish_color_normal {h(mat['on_surface'])}
set -g fish_color_command {h(mat['primary'])}
set -g fish_color_keyword {h(mat['tertiary'])}
set -g fish_color_quote {h(d16['color3']['default'])}
set -g fish_color_redirection {h(mat['tertiary'])} --bold
set -g fish_color_end {h(d16['color2']['default'])}
set -g fish_color_error {h(mat['error'])}
set -g fish_color_param {h(mat['secondary'])}
set -g fish_color_comment {h(mat['outline'])}
set -g fish_color_operator {h(d16['color6']['default'])}
set -g fish_color_escape {h(d16['color6']['default'])}
set -g fish_color_autosuggestion {h(mat['outline'])}
set -g fish_color_selection --background={h(mat['surface_bright'])}
set -g fish_color_search_match --background={h(mat['surface_bright'])}
set -g fish_color_cwd {h(d16['color4']['default'])}
set -g fish_color_user {h(d16['color2']['default'])}
set -g fish_color_host {h(mat['primary'])}
set -g fish_color_host_remote {h(d16['color3']['default'])}
set -g fish_color_cancel -r
set -g fish_color_valid_path --underline
set -g fish_color_status {h(mat['error'])}
"""

fish_output = Path.home() / ".config/fish/conf.d/dms-colors.fish"
with open(fish_output, "w") as f:
    f.write(fish_colors)

print(f"Generated {fish_output}")
