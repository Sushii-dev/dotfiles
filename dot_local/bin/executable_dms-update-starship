#!/usr/bin/env python3
"""Read DMS colors and generate starship.toml + fish colors from template."""
import json
from pathlib import Path

colors_file = Path.home() / ".cache/DankMaterialShell/dms-colors.json"
template_file = Path.home() / ".config/matugen/templates/starship.toml"
starship_output = Path.home() / ".config/starship.toml"
fish_output = Path.home() / ".config/fish/conf.d/dms-colors.fish"

with open(colors_file) as f:
    data = json.load(f)

d16 = data["dank16"]
mat = data["colors"]["dark"]

# --- Starship ---
replacements = {
    "{{colors.primary_container.default.hex}}": mat["primary_container"],
    "{{colors.secondary_container.default.hex}}": mat["secondary_container"],
    "{{colors.primary.default.hex}}": mat["primary"],
    "{{colors.on_surface.default.hex}}": mat["on_surface"],
    "{{colors.background.default.hex}}": mat["background"],
    "{{colors.outline.default.hex}}": mat["outline"],
    "{{colors.error.default.hex}}": mat["error"],
    "{{dank16.color1.default.hex}}": d16["color1"]["default"],
    "{{dank16.color2.default.hex}}": d16["color2"]["default"],
    "{{dank16.color3.default.hex}}": d16["color3"]["default"],
    "{{dank16.color4.default.hex}}": d16["color4"]["default"],
    "{{dank16.color5.default.hex}}": d16["color5"]["default"],
}

with open(template_file) as f:
    content = f.read()

for placeholder, value in replacements.items():
    content = content.replace(placeholder, value)

with open(starship_output, "w") as f:
    f.write(content)

print(f"Generated {starship_output}")

# --- Fish colors ---
# Strip # from hex for fish
def h(color):
    return color.lstrip("#")

fish_colors = f"""# Auto-generated from DMS colors — do not edit manually
set -g fish_color_normal {h(mat['on_surface'])}
set -g fish_color_command {h(mat['primary'])}
set -g fish_color_keyword {h(mat['tertiary'])}
set -g fish_color_quote {h(d16['color3']['default'])}
set -g fish_color_redirection {h(mat['tertiary'])} --bold
set -g fish_color_end {h(d16['color2']['default'])}
set -g fish_color_error {h(mat['error'])}
set -g fish_color_param {h(mat['secondary'])}
set -g fish_color_comment {h(mat['outline'])}
set -g fish_color_operator {h(d16['color6']['default'])}
set -g fish_color_escape {h(d16['color6']['default'])}
set -g fish_color_autosuggestion {h(mat['outline'])}
set -g fish_color_selection --background={h(mat['surface_bright'])}
set -g fish_color_search_match --background={h(mat['surface_bright'])}
set -g fish_color_cwd {h(d16['color4']['default'])}
set -g fish_color_user {h(d16['color2']['default'])}
set -g fish_color_host {h(mat['primary'])}
set -g fish_color_host_remote {h(d16['color3']['default'])}
set -g fish_color_cancel -r
set -g fish_color_valid_path --underline
set -g fish_color_status {h(mat['error'])}
"""

with open(fish_output, "w") as f:
    f.write(fish_colors)

print(f"Generated {fish_output}")
