#!/usr/bin/env bash
# pokemirror — mirror a real Android phone to the desktop with scrcpy, for
# playing portrait-locked Pokémon titles (Pokémon GO, Pokémon TCG Pocket).
#
# The games run on the phone: real GPS, real Play Integrity attestation.
# The desktop is display + input only. No automation, no macros, no scripted
# taps — those are bannable in both titles and this script will never add them.
#
# Usage:
#   pokemirror pair           one-time WIRELESS pairing (Android 11+, no cable)
#   pokemirror setup          one-time USB pairing: enables adb over TCP, saves IP
#   pokemirror pogo           launch Pokémon GO   (latency profile)
#   pokemirror tcgp           launch TCG Pocket   (smoothness profile)
#   pokemirror duo [profile]  two accounts side by side (main + Secure Folder)
#   pokemirror connect        connect adb over TCP only
#   pokemirror status         show connection, resolved packages, panel size
#   pokemirror apps           list Pokémon-ish packages on the phone
#   pokemirror config         print the config file path and contents
#
# Config: ~/.config/pokemirror/config  (host-specific, NOT tracked by chezmoi)
#   PHONE_IP=192.168.1.50
#   PHONE_PORT=5555
#   PKG_POGO=com.nianticlabs.pokemongo
#   PKG_TCGP=jp.pokemon.pokemontcgp
#   CONNECTION=auto          # auto | usb | tcp — auto prefers USB when plugged in
#   CODEC=h265               # h264 decodes a touch faster on some setups
#   OUTPUT=DP-1              # KDE only: pin the window to this connector
#                            #   (under niri the window rule in config.kdl does this)
#   AUDIO=1                  # forward phone audio to the desktop's default sink
#   AUDIO_BUFFER=            # ms; empty = 150 over Wi-Fi, 50 over USB.
#   AUDIO_OUTPUT_BUFFER=     # ms; empty = 15 over Wi-Fi, 5 over USB.
#                            #   Raise both if audio crackles or warbles.
#   MAX_FPS=60               # phone-side encode cap. 30 roughly halves the
#                            #   encoder's work if the phone is thermally throttling.
#   PANEL=1080x1920          # virtual display size; default = phone's native panel
#   DPI=420                  # lower = smaller UI = more content on screen
#   FULLSCREEN=1             # 1 -> scrcpy opens fullscreen (pairs with PANEL=output size)
#   VD_DECORATIONS=0         # 1 -> drop --no-vd-system-decorations
#   EXTRA_ARGS=              # appended verbatim to every scrcpy invocation
#   DUO_OUTPUT=DP-2          # duo mode: output the two panes sit on
#   DUO_GAP=40               # px between the panes
#   DUO_ASPECT=auto          # pane aspect; auto = phone panel, so panes match
#   DUO_PANEL=               # override the computed pane size, e.g. 800x1400
#   DUO_MIRROR_DISPLAY=0     # phone display pane 2 mirrors (0 cover, 1 inner)
#   DUO_MODE=nested          # nested = ONE window holding both panes (movable and
#                            #   scalable as a unit, via a nested sway compositor);
#                            #   separate = two independent windows
#
# Duo mode shows two accounts at once. Pane 1 is the normal install on its own
# virtual display, started automatically. Pane 2 MIRRORS THE PHONE'S OWN SCREEN,
# where the Secure Folder copy has to be opened by hand — Knox refuses to let
# adb touch the Secure Folder user at all ("Shell does not have permission to
# access user 150"), so it cannot be launched or moved remotely. Mirroring
# copies pixels and needs no such permission.
#
# USB is the low-latency transport. Wi-Fi adds jitter that shows up exactly
# where it hurts — Pokémon GO ball throws — and drops the link when the phone
# roams or dozes. Under CONNECTION=auto a plugged-in phone always wins, and the
# bit rate is raised because USB bandwidth is free.
#
# To fill a portrait monitor edge to edge, set PANEL to the monitor's ROTATED
# logical size and turn FULLSCREEN on — e.g. a 1920x1080 panel mounted at 90°
# is logically 1080x1920, so PANEL=1080x1920 renders 1:1 with no rescaling.
# Extra args can also be passed per launch: pokemirror pogo --print-fps

set -uo pipefail

CONF_KEYS='CONNECTION|CODEC|PANEL|DPI|FULLSCREEN|VD_DECORATIONS|EXTRA_ARGS|PHONE_IP|PHONE_PORT|PKG_POGO|PKG_TCGP|OUTPUT|AUDIO|AUDIO_BUFFER|AUDIO_OUTPUT_BUFFER|MAX_FPS|KEEP_ON_DISPLAY|DUO_OUTPUT|DUO_GAP|DUO_ASPECT|DUO_PANEL|DUO_USER|DUO_MIRROR_DISPLAY|DUO_MODE'

# Snapshot deliberate one-off overrides (CONNECTION=usb pokemirror pogo) BEFORE
# the defaults below are assigned. Assigning to an already-exported name would
# overwrite the environment too, so capturing any later than this loses them.
ENV_OVERRIDES=$(printenv | grep -E "^(${CONF_KEYS})=" || true)

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pokemirror"
CONF="$CONF_DIR/config"

PHONE_PORT=5555
DPI=420
FULLSCREEN=0
VD_DECORATIONS=0
PANEL=""
PHONE_IP=""
PKG_POGO=""
PKG_TCGP=""
EXTRA_ARGS=""
CONNECTION=auto     # auto | usb | tcp
CODEC=h265
OUTPUT=""           # KDE only: connector name to pin the window to, e.g. DP-1
AUDIO=1             # 1 -> forward phone audio to the desktop (phone goes silent)
AUDIO_BUFFER=""        # ms; empty = 150 over Wi-Fi, 50 over USB
AUDIO_OUTPUT_BUFFER="" # ms; empty = 15 over Wi-Fi, scrcpy default (5) over USB
MAX_FPS=60             # phone-side encode cap; drop to 30 if the phone throttles
KEEP_ON_DISPLAY=1      # move the app back if it restarts onto the phone's screen
DUO_OUTPUT="DP-2"      # duo mode: which output the two panes sit on
DUO_GAP=40             # px between the two panes
DUO_ASPECT="auto"      # pane aspect; auto = the phone panel, so both panes match
DUO_PANEL=""           # override the computed per-pane size, e.g. 800x1400
DUO_USER=""            # Secure Folder user id; informational only (autodetected)
DUO_MIRROR_DISPLAY=0   # phone display the 2nd pane mirrors (0 = cover, 1 = inner)
DUO_MODE=nested        # nested = one window holding both panes | separate = two windows

# Resolved by pick_transport().
TRANSPORT=""
ADB_SERIAL=""

# Package name patterns. Names are resolved on the device at runtime; these are
# only search patterns, never assumed to be the real package id.
PAT_POGO='nianticlabs\.pokemongo|com\.pokemongo|pokemongo'
PAT_TCGP='pokemontcgp|pokemon.*tcg|tcg.*pocket'

# scrcpy exit codes: 0 success, 1 failure, 2 device disconnected.
EXIT_DISCONNECTED=2

RECONNECT_TRIES=5

c_red=$'\033[31m'; c_yel=$'\033[33m'; c_grn=$'\033[32m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
info()  { printf '%s==>%s %s\n' "$c_grn" "$c_off" "$*"; }
warn()  { printf '%s==>%s %s\n' "$c_yel" "$c_off" "$*" >&2; }
die()   { printf '%s==>%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
dim()   { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not installed (pacman -S ${2:-$1})"; }

load_conf() {
    local kv
    if [ -f "$CONF" ]; then
        # shellcheck disable=SC1090
        source "$CONF"
    fi
    # Environment beats the config file, so one-off overrides actually apply.
    while IFS= read -r kv; do
        [ -n "$kv" ] && declare -g "$kv"
    done <<< "$ENV_OVERRIDES"
}

save_conf_key() {
    local key=$1 val=$2
    mkdir -p "$CONF_DIR"
    touch "$CONF"
    if grep -q "^${key}=" "$CONF" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONF"
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONF"
    fi
}

serial() { printf '%s:%s' "$PHONE_IP" "$PHONE_PORT"; }

# --- connection ------------------------------------------------------------

# Prints the device state for the TCP serial: device | offline | unauthorized | absent
dev_state() {
    local s
    s=$(adb devices | awk -v d="$(serial)" '$1==d {print $2}')
    printf '%s' "${s:-absent}"
}

usb_serial() {
    adb devices | awk '$2=="device" && $1 !~ /:/ {print $1; exit}'
}

# A USB device visible to the kernel but not to us — the udev rules from
# android-udev grant access via the adbusers group, and group membership only
# takes effect on a fresh login.
usb_denied() {
    adb devices 2>/dev/null | grep -q 'no permissions'
}

usb_perm_hint() {
    cat >&2 <<EOF

${c_yel}A phone is plugged in but adb has no permission to talk to it.${c_off}
android-udev gates adb behind the 'adbusers' group, which only applies at login.
/etc/udev/rules.d/52-android-uaccess.rules is supposed to sidestep that by
ACLing the device to the active session — check it exists and covers this
phone's USB vendor id (\`lsusb\` to find it; 04e8 is Samsung):

    sudo udevadm control --reload-rules && sudo udevadm trigger

Failing that, in the terminal you launch pokemirror from:

    adb kill-server
    newgrp adbusers
EOF
}

usb_missing_hint() {
    cat >&2 <<EOF

${c_yel}No USB phone in 'adb devices'.${c_off}
  - use a DATA cable, not a charge-only one
  - if a mode picker appears on the phone, choose "File transfer"
  - Developer options > USB debugging must be ON
  - accept the "Allow USB debugging?" prompt (tick "Always allow")

Or set CONNECTION=tcp in ${CONF} to go back over Wi-Fi.
EOF
}

# Decides which transport to use and sets TRANSPORT + ADB_SERIAL.
# USB is preferred under 'auto': no Wi-Fi jitter, and bandwidth is free.
pick_transport() {
    local usb
    case "$CONNECTION" in
        usb)
            usb=$(usb_serial)
            if [ -z "$usb" ]; then
                usb_denied && { usb_perm_hint; return 1; }
                usb_missing_hint; return 1
            fi
            TRANSPORT=usb; ADB_SERIAL=$usb ;;
        tcp)
            ensure_connected || return 1
            TRANSPORT=tcp; ADB_SERIAL=$(serial) ;;
        auto)
            usb=$(usb_serial)
            if [ -n "$usb" ]; then
                TRANSPORT=usb; ADB_SERIAL=$usb
            else
                usb_denied && usb_perm_hint
                ensure_connected || return 1
                TRANSPORT=tcp; ADB_SERIAL=$(serial)
            fi ;;
        *) die "CONNECTION must be auto, usb or tcp (got: $CONNECTION)" ;;
    esac
}

reboot_hint() {
    cat >&2 <<EOF

${c_yel}Phone is not listening on TCP port ${PHONE_PORT}.${c_off}
adb's TCP mode does not survive a phone reboot. Plug the phone in over USB and:

    pokemirror setup

(or manually: adb tcpip ${PHONE_PORT}, then unplug)
EOF
}

connect() {
    local quiet=${1:-}
    [ -n "$PHONE_IP" ] || die "PHONE_IP not set — run: pokemirror setup"

    case "$(dev_state)" in
        device) [ -n "$quiet" ] || info "already connected to $(serial)"; return 0 ;;
        offline|unauthorized) adb disconnect "$(serial)" >/dev/null 2>&1 ;;
    esac

    local out
    out=$(adb connect "$(serial)" 2>&1)
    if [ "$(dev_state)" = device ]; then
        [ -n "$quiet" ] || info "connected to $(serial)"
        return 0
    fi

    case "$out" in
        *unauthorized*)
            warn "$out"
            die "Phone shows an 'Allow USB debugging?' prompt — accept it (tick 'Always allow'), then retry." ;;
        *)
            warn "$out"
            reboot_hint
            return 1 ;;
    esac
}

ensure_connected() {
    connect quiet && return 0
    return 1
}

# --- device queries --------------------------------------------------------

ash() { adb -s "${ADB_SERIAL:-$(serial)}" shell "$@" 2>/dev/null | tr -d '\r'; }

panel_size() {
    [ -n "$PANEL" ] && { printf '%s' "$PANEL"; return 0; }
    # "Physical size: 1080x2400" (+ optionally "Override size: ...")
    local s
    s=$(ash wm size | awk -F': ' '/Physical size/ {print $2; exit}')
    [ -n "$s" ] || return 1
    printf '%s' "$s"
}

list_pkgs() {
    ash pm list packages | sed 's/^package://'
}

resolve_pkg() {
    local pattern=$1
    list_pkgs | grep -iE "$pattern" | head -1
}

# resolve_and_cache <conf_key> <current_value> <pattern> <label>
resolve_and_cache() {
    local key=$1 cur=$2 pattern=$3 label=$4 pkg
    if [ -n "$cur" ] && list_pkgs | grep -qxF "$cur"; then
        printf '%s' "$cur"; return 0
    fi
    pkg=$(resolve_pkg "$pattern")
    if [ -z "$pkg" ]; then
        warn "$label not found on the phone. Installed Pokémon-ish packages:"
        list_pkgs | grep -iE 'poke|niantic' >&2 || echo "  (none)" >&2
        return 1
    fi
    save_conf_key "$key" "$pkg"
    printf '%s' "$pkg"
}

# --- window placement ------------------------------------------------------
#
# Wayland clients cannot place their own windows, so scrcpy's --fullscreen lands
# on whatever output the compositor chose. Under niri a window rule handles it.
# Under KWin the equivalent is a scripting call: a kwinrulesrc `screen=` rule
# does NOT work here, because scrcpy is already fullscreen by the time the rule
# would apply and KWin just pins it to the wrong output.
#
# sendClientToScreen only takes effect while the window is NOT fullscreen, and
# the fullScreen write round-trips to the client asynchronously, so this drops
# fullscreen, moves, and re-applies it — then repeats, because the window may
# not exist yet when scrcpy is still pushing its server jar.

kwin_present() { busctl --user status org.kde.KWin >/dev/null 2>&1; }

kwin_place_once() {
    local target=$1 js id
    js=$(mktemp --tmpdir pokemirror-place-XXXXXX.js)
    cat > "$js" <<EOF
const TARGET = "${target}";
let scr = null;
for (const s of workspace.screens) { if (s.name === TARGET) scr = s; }
if (scr) {
  const g = scr.geometry;
  for (const w of workspace.windowList()) {
    if ((w.resourceClass || "").toString().indexOf("scrcpy") === -1) continue;
    // fullScreen can read true while the client is still sized to its own
    // default (70% of the screen), so the geometry has to agree too — otherwise
    // later passes skip a window that is fullscreen in name only.
    const f = w.frameGeometry;
    if (w.output && w.output.name === TARGET && w.fullScreen &&
        f.width === g.width && f.height === g.height) continue;
    w.fullScreen = false;
    workspace.sendClientToScreen(w, scr);
    w.fullScreen = true;
  }
}
EOF
    id=$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting \
            loadScript ss "$js" "pokemirror-place" 2>/dev/null | awk '{print $2}')
    if [ -n "$id" ]; then
        busctl --user call "org.kde.KWin" "/Scripting/Script${id}" \
            org.kde.kwin.Script run >/dev/null 2>&1
        busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting \
            unloadScript s "pokemirror-place" >/dev/null 2>&1
    fi
    rm -f "$js"
}

# Fire and forget: scrcpy blocks in the foreground, so the placer runs behind it.
kwin_place_async() {
    local target=$1
    [ -n "$target" ] || return 0
    kwin_present || return 0
    (
        for delay in 2 2 3 4 5; do
            sleep "$delay"
            kwin_place_once "$target"
        done
    ) >/dev/null 2>&1 &
}

# --- keeping the app on the virtual display --------------------------------
#
# --start-app places the app on the virtual display exactly once. When the app
# restarts itself — after an update, or its own "restarting" flow — Android
# launches the new task on the DEFAULT display instead. The mirror then shows an
# empty virtual display while audio keeps playing, because --audio-source=output
# captures the whole device and does not care which display the app is on.
#
# The app is moved back whenever it is running on a display that is not ours.
# A package with no activity record anywhere is left alone, but note that a
# crash or force-stop usually leaves Android resurrecting the task on the
# default display, and that gets pulled back too — self-healing rather than a
# deliberate-quit detector. To actually stop it, close the mirror; the watcher
# dies with scrcpy.

app_display() {
    ash dumpsys activity activities | awk -v pkg="$1" '
        /Display #[0-9]+ \(activities/ { n=$0; sub(/.*Display #/,"",n); sub(/ .*/,"",n); cur=n }
        index($0,pkg) && index($0,"ActivityRecord") { print cur; exit }'
}

keep_on_display() {
    local pkg=$1 did=$2 comp cur
    comp=$(ash cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$pkg" | tail -1)
    case "$comp" in
        */*) ;;
        *) return 0 ;;   # could not resolve a launch component; do nothing
    esac
    while sleep 5; do
        cur=$(app_display "$pkg")
        [ -z "$cur" ] && continue           # not running: deliberate quit
        [ "$cur" = "$did" ] && continue     # already where it belongs
        warn "app restarted onto display $cur — moving it back to $did"
        ash am start --display "$did" -n "$comp" >/dev/null
    done
}

# scrcpy reports the virtual display id on stdout once the server is up, so the
# watcher waits for it to appear in the tee'd log rather than guessing.
keep_on_display_async() {
    local pkg=$1 logf=$2 did=""
    [ "$KEEP_ON_DISPLAY" = 1 ] || return 0
    (
        for _ in $(seq 1 30); do
            sleep 1
            did=$(grep -o 'New display: [^(]*(id=[0-9]*)' "$logf" 2>/dev/null \
                  | tail -1 | grep -o '[0-9]*)' | tr -d ')')
            [ -n "$did" ] && break
        done
        [ -n "$did" ] && keep_on_display "$pkg" "$did"
    ) >/dev/null &
}

# --- duo: two accounts side by side ----------------------------------------
#
# Samsung's Secure Folder is a separate Android user (150 here), so the second
# account's copy of the game is the same package under that user id. adb CANNOT
# drive it: Knox denies the shell user access to the container outright —
#
#   $ adb shell am start --user 150 -n <component>
#   SecurityException: Shell does not have permission to access user 150
#       at ActivityManagerService$LocalService.handleIncomingUser
#
# and `pm list packages --user 150` fails the same way. No flag works around it;
# only root would, which would break Play Integrity and take Pokémon GO with it.
#
# So the second pane does not launch anything. It mirrors the phone's REAL
# screen (display 0), where the Secure Folder copy is opened by hand. Mirroring
# copies pixels and needs no cross-user permission at all.
#
# Pane 1: virtual display, main account, started automatically.
# Pane 2: the phone's own screen, Secure Folder account, opened manually.
#
# Audio is captured device-wide, so only the first instance forwards it — that
# single stream already contains both games.

sf_user() {
    ash pm list users | awk -F'[{:]' '/Secure ?Folder/ {print $2; exit}'
}

# Prints: PANEL_W PANEL_H X1 Y1 X2 Y2 for two portrait panes on $1, gap $2.
duo_geometry() {
    kscreen-doctor -j 2>/dev/null | python3 -c '
import json, sys
name, gap, aspect = sys.argv[1], int(sys.argv[2]), sys.argv[3]
num, den = (int(v) for v in aspect.split(":"))
for o in json.load(sys.stdin).get("outputs", []):
    if o.get("name") == name and o.get("enabled"):
        p, s = o["pos"], o["size"]
        ow, oh = s["width"], s["height"]
        h = oh - 40
        w = (int(h * num / den) // 2) * 2
        total = 2 * w + gap
        if total > ow:                      # narrow output: shrink to fit
            w = (ow - gap) // 2 // 2 * 2
            h = (int(w * den / num) // 2) * 2
            total = 2 * w + gap
        x0 = p["x"] + (ow - total) // 2
        y0 = p["y"] + (oh - h) // 2
        print(w, h, x0, y0, x0 + w + gap, y0)
        break
' "$1" "$2" "$DUO_ASPECT"
}

# --- nested mode: both panes inside ONE host window ------------------------
#
# scrcpy opens one toplevel per instance and there is no way to make it share a
# window. To get a single thing to move and scale, a nested wlroots compositor
# (sway, already installed) runs as one Wayland client on the KDE session and
# tiles both scrcpy instances inside it. Its own toplevel is then the single
# window, and the nested output tracks that toplevel's size — resize the window
# and both panes resize with it.
#
# Measured on this machine: at rest the nested output matches the host window
# exactly (1060x454 == 1060x454). It does follow resizes, but not always to the
# exact frame size — maximising gave a 1080x1920 frame and a 1060x918 nested
# output, i.e. the panes rescale but can leave a black margin. sway's own
# `output WL-1 resolution` is ignored by the wayland backend, and kdotool's
# windowsize is a no-op under this KWin (verified against a control window), so
# the initial size has to come from a KWin rule instead.

kwin_nested_size_rule() {
    local w=$1 h=$2
    kwin_present || return 0
    python3 - "$w" "$h" <<'PY' >/dev/null 2>&1 || return 0
import configparser, os, sys, uuid
w, h = sys.argv[1], sys.argv[2]
p = os.path.expanduser("~/.config/kwinrulesrc")
c = configparser.RawConfigParser(); c.optionxform = str; c.read(p)
sid = None
for s in c.sections():
    if c.has_option(s, "Description") and "pokemirror duo" in c.get(s, "Description"):
        sid = s
if sid is None:
    sid = str(uuid.uuid4()); c.add_section(sid)
c.set(sid, "Description", "pokemirror duo (nested compositor) initial size")
c.set(sid, "clientmachine", "localhost")
c.set(sid, "wmclass", "wlroots")     # wlroots' wayland backend app_id
c.set(sid, "wmclassmatch", "1")      # exact; substring matching did not apply
c.set(sid, "size", "%s,%s" % (w, h))
c.set(sid, "sizerule", "2")          # 2 = Apply Initially (Force did not apply)
ids = [s for s in c.sections() if s != "General"]
if not c.has_section("General"): c.add_section("General")
c.set("General", "count", str(len(ids)))
c.set("General", "rules", ",".join(ids))
with open(p, "w") as fh: c.write(fh, space_around_delimiters=False)
PY
    busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure >/dev/null 2>&1
}

launch_duo_nested() {
    local title=$1 pw=$2 ph=$3 gap=$4; shift 4
    local a_cmd=$1 b_cmd=$2

    command -v sway >/dev/null 2>&1 || die "sway is not installed (pacman -S sway) — needed for DUO_MODE=nested"

    local dir cfg sock
    dir=$(mktemp -d --tmpdir pokemirror-nested-XXXXXX)
    cfg="$dir/sway.conf"
    # Per-session socket: a fixed path means a second session cannot bind and
    # silently ends up somewhere else, and then swaymsg talks to the wrong one.
    sock="$dir/sway.sock"

    printf '%s\n' '#!/usr/bin/env bash' "exec $a_cmd" > "$dir/pane-a"
    printf '%s\n' '#!/usr/bin/env bash' "exec $b_cmd" > "$dir/pane-b"
    chmod +x "$dir/pane-a" "$dir/pane-b"

    # Quit the nested session once both panes are gone, so closing the games
    # closes the window instead of leaving an empty compositor behind.
    # Ask sway about ITS OWN tree rather than counting scrcpy processes globally,
    # so a second nested session running alongside cannot make this one quit.
    cat > "$dir/reaper" <<REAP
#!/usr/bin/env bash
export SWAYSOCK="$sock"
sleep 10
while :; do
    n=\$(swaymsg -t get_tree 2>/dev/null | grep -c '"pid":' )
    [ "\${n:-0}" -eq 0 ] && break
    sleep 2
done
swaymsg exit >/dev/null 2>&1
REAP
    chmod +x "$dir/reaper"

    cat > "$cfg" <<EOF
# generated by pokemirror — nested duo session
default_border none
default_floating_border none
focus_follows_mouse no
output * bg #101010 solid_color
gaps inner $gap
bindsym Mod4+Shift+e exec swaymsg exit
exec $dir/pane-a
exec $dir/pane-b
exec $dir/reaper
EOF

    # Two panes plus the gap between them, so each tile lands on the phone's
    # own aspect and scrcpy does not letterbox inside its tile.
    kwin_nested_size_rule $((2 * pw + 3 * gap)) $((ph + 2 * gap))

    info "nested session — one window ($((2 * pw + 3 * gap))x$((ph + 2 * gap))) holding two ${pw}x${ph} panes; drag to move, drag an edge to scale"
    SWAYSOCK="$sock" sway --unsupported-gpu -c "$cfg"
    local rc=$?
    # Only reap the panes this session started; another duo session may be up.
    pkill -f "^$dir/pane-" >/dev/null 2>&1
    rm -rf "$dir"
    return $rc
}

duo_place() {
    local title=$1 x=$2 y=$3 w=$4 h=$5 id
    command -v kdotool >/dev/null 2>&1 || return 0
    for _ in $(seq 1 20); do
        id=$(kdotool search --name "$title" 2>/dev/null | head -1)
        [ -n "$id" ] && break
        sleep 1
    done
    [ -n "$id" ] || { warn "could not find the window titled '$title' to place it"; return 0; }
    # Size before move: KWin can shove an oversized window back on-screen.
    kdotool windowsize "$id" "$w" "$h" >/dev/null 2>&1
    kdotool windowmove "$id" "$x" "$y" >/dev/null 2>&1
}

launch_duo() {
    local profile=${1:-tcgp} pkg title comp sfu geom pw ph x1 y1 x2 y2
    shift 2>/dev/null || true

    pick_transport || exit 1

    case "$profile" in
        pogo) pkg=$(resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO") || exit 1
              title="Pokémon GO" ;;
        tcgp) pkg=$(resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket") || exit 1
              title="Pokémon TCG Pocket" ;;
        *)    die "unknown profile: $profile" ;;
    esac

    sfu=${DUO_USER:-$(sf_user)}
    cat <<EOF

${c_yel}Open ${title} inside Secure Folder on the phone now${c_off}${sfu:+ (user $sfu)}.
Knox blocks adb from launching into Secure Folder, so the second pane mirrors
the phone's own screen instead — whatever is showing there is what you get.
Leave the Secure Folder copy in the foreground on the phone.

EOF

    # Pane 2 mirrors the phone's real screen, and scrcpy holds that content's
    # aspect no matter what size the window is given. Matching pane 1 to the
    # phone's panel keeps the two the same width instead of leaving one narrower.
    if [ "$DUO_ASPECT" = auto ]; then
        local phys
        phys=$(ash wm size | awk -F': ' '/Physical size/ {print $2; exit}')
        case "$phys" in
            *x*) DUO_ASPECT="${phys%x*}:${phys#*x}" ;;
            *)   DUO_ASPECT="9:21" ;;
        esac
    fi

    geom=$(duo_geometry "$DUO_OUTPUT" "$DUO_GAP")
    [ -n "$geom" ] || die "output '$DUO_OUTPUT' not found — set DUO_OUTPUT to a connector from 'kscreen-doctor -o'"
    read -r pw ph x1 y1 x2 y2 <<< "$geom"
    [ -n "$DUO_PANEL" ] && { pw=${DUO_PANEL%x*}; ph=${DUO_PANEL#*x}; }

    info "$title duo — ${TRANSPORT^^} — 2x ${pw}x${ph} @ ${DPI}dpi on $DUO_OUTPUT — user 0 + $sfu"

    local common=(
        -s "$ADB_SERIAL"
        --video-codec="$CODEC"
        --max-fps="$MAX_FPS"
        --new-display="${pw}x${ph}/${DPI}"
        --video-bit-rate="$([ "$TRANSPORT" = usb ] && echo 12M || echo 6M)"
        --video-buffer=50
    )
    [ "$VD_DECORATIONS" = 1 ] || common+=(--no-vd-system-decorations)

    local a_args=("${common[@]}" --window-title="$title — Main" --start-app="$pkg")
    if [ "$AUDIO" = 1 ]; then
        local abuf=$AUDIO_BUFFER obuf=$AUDIO_OUTPUT_BUFFER
        [ -n "$abuf" ] || { [ "$TRANSPORT" = usb ] && abuf=50 || abuf=150; }
        [ -n "$obuf" ] || { [ "$TRANSPORT" != usb ] && obuf=15; }
        a_args+=(--audio-codec=opus --audio-buffer="$abuf")
        [ -n "$obuf" ] && a_args+=(--audio-output-buffer="$obuf")
    else
        a_args+=(--no-audio)
    fi
    # Second instance mirrors the phone's real screen rather than creating a
    # display, and never forwards audio: the first already captures the whole
    # device mix, and two REMOTE_SUBMIX captures would fight over it.
    local b_args=(
        -s "$ADB_SERIAL"
        --video-codec="$CODEC"
        --max-fps="$MAX_FPS"
        --display-id="$DUO_MIRROR_DISPLAY"
        --video-bit-rate="$([ "$TRANSPORT" = usb ] && echo 12M || echo 6M)"
        --video-buffer=50
        --window-title="$title — Secure Folder"
        --no-audio
    )

    if [ "$DUO_MODE" = nested ]; then
        # sway applies its inner gap at the edges too, so the host window has to
        # carry three gaps across and two down on top of the panes themselves.
        # Shrink the panes to fit rather than letting them overflow the output.
        local nph npw anum aden
        anum=${DUO_ASPECT%:*}; aden=${DUO_ASPECT#*:}
        nph=$((ph - 2 * DUO_GAP))
        npw=$(( (nph * anum / aden) / 2 * 2 ))
        info "nested panes ${npw}x${nph} (shrunk from ${pw}x${ph} to leave room for gaps)"
        launch_duo_nested "$title" "$npw" "$nph" "$DUO_GAP" \
            "$(printf '%q ' scrcpy "${a_args[@]}")" \
            "$(printf '%q ' scrcpy "${b_args[@]}")"
        return $?
    fi

    local loga logb pida pidb
    loga=$(mktemp --tmpdir pokemirror-duo-a-XXXXXX)
    logb=$(mktemp --tmpdir pokemirror-duo-b-XXXXXX)

    scrcpy "${a_args[@]}" > >(tee "$loga") 2>&1 &
    pida=$!
    scrcpy "${b_args[@]}" > >(tee "$logb") 2>&1 &
    pidb=$!

    cleanup_duo() {
        kill "$pida" "$pidb" 2>/dev/null
        rm -f "$loga" "$logb"
    }
    trap cleanup_duo EXIT INT TERM

    duo_place "$title — Main" "$x1" "$y1" "$pw" "$ph" &
    duo_place "$title — Secure Folder" "$x2" "$y2" "$pw" "$ph" &

    # Whichever window is closed first takes the other with it.
    wait -n "$pida" "$pidb" 2>/dev/null
    info "one instance exited — closing the other"
    cleanup_duo
    trap - EXIT INT TERM
    wait 2>/dev/null
    return 0
}

# --- profiles --------------------------------------------------------------

launch() {
    local profile=$1 pkg res title args=()
    shift
    local cli_args=("$@")   # anything after the profile goes straight to scrcpy

    pick_transport || exit 1

    res=$(panel_size) || die "could not read the phone's panel size (adb shell wm size)"

    # Over USB there is bandwidth to spare, so spend it on picture quality; over
    # Wi-Fi a fatter stream is the first thing to stutter when the link dips.
    local rate_hi rate_lo
    if [ "$TRANSPORT" = usb ]; then rate_hi=16M; rate_lo=12M; else rate_hi=8M; rate_lo=6M; fi

    case "$profile" in
        pogo)
            pkg=$(resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO") || exit 1
            title="Pokémon GO"
            # Latency critical: ball throws are timing-sensitive, so no buffer.
            args=(--video-buffer=0 --video-bit-rate="$rate_hi")
            ;;
        tcgp)
            pkg=$(resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket") || exit 1
            title="Pokémon TCG Pocket"
            # Turn based: trade latency for a smoother pack-opening animation.
            args=(--video-buffer=50 --video-bit-rate="$rate_lo")
            ;;
        *) die "unknown profile: $profile" ;;
    esac

    local base=(
        -s "$ADB_SERIAL"
        --video-codec="$CODEC"
        --max-fps="$MAX_FPS"
        --new-display="${res}/${DPI}"
        --start-app="$pkg"
        --window-title="$title"
    )
    [ "$VD_DECORATIONS" = 1 ] || base+=(--no-vd-system-decorations)
    [ "$FULLSCREEN" = 1 ] && base+=(--fullscreen)
    if [ "$AUDIO" = 1 ]; then
        # --audio-source=output (scrcpy's default) forwards the whole device
        # output AND silences the phone's own speaker, which is the point: sound
        # arrives on whatever PipeWire calls the default sink. Opus is the
        # lowest-latency codec scrcpy offers.
        #
        # Crackle is the audio buffer running dry. Wi-Fi delivers packets in
        # bursts, so it needs a much deeper buffer than USB — scrcpy's 50ms
        # default is a USB number. The cost is audio latency, which matters far
        # less than dropouts because the video has its own separate buffer.
        #
        # Warble is the same problem wearing a different hat. scrcpy keeps the
        # phone's audio clock aligned with the desktop's by inserting and
        # dropping samples; jitter makes that correction hunt, and hunting
        # sounds like a warped record. A deeper buffer gives it slack so it
        # corrects gently instead of constantly.
        local abuf=$AUDIO_BUFFER obuf=$AUDIO_OUTPUT_BUFFER
        if [ -z "$abuf" ]; then
            [ "$TRANSPORT" = usb ] && abuf=50 || abuf=150
        fi
        if [ -z "$obuf" ] && [ "$TRANSPORT" != usb ]; then
            obuf=15
        fi
        base+=(--audio-codec=opus --audio-buffer="$abuf")
        [ -n "$obuf" ] && base+=(--audio-output-buffer="$obuf")
    else
        base+=(--no-audio)
    fi
    # shellcheck disable=SC2206
    [ -n "$EXTRA_ARGS" ] && base+=($EXTRA_ARGS)
    [ ${#cli_args[@]} -gt 0 ] && base+=("${cli_args[@]}")

    info "$title — ${TRANSPORT^^} ${ADB_SERIAL} — ${res} @ ${DPI}dpi$([ "$FULLSCREEN" = 1 ] && echo ' — fullscreen') — $pkg"
    dim "  scrcpy ${base[*]} ${args[*]}"

    local tries=0 rc logf watcher
    while :; do
        kwin_place_async "$OUTPUT"
        logf=$(mktemp --tmpdir pokemirror-log-XXXXXX)
        keep_on_display_async "$pkg" "$logf"
        watcher=$!
        scrcpy "${base[@]}" "${args[@]}" 2>&1 | tee "$logf"
        rc=${PIPESTATUS[0]}
        [ -n "$watcher" ] && kill "$watcher" 2>/dev/null
        rm -f "$logf"
        [ $rc -eq 0 ] && { info "closed"; return 0; }

        tries=$((tries + 1))
        if [ $tries -gt $RECONNECT_TRIES ]; then
            die "gave up after $RECONNECT_TRIES reconnect attempts (last exit $rc)"
        fi

        if [ $rc -eq $EXIT_DISCONNECTED ]; then
            warn "device disconnected — reconnecting (${tries}/${RECONNECT_TRIES})"
        else
            warn "scrcpy exited $rc — retrying (${tries}/${RECONNECT_TRIES})"
        fi

        sleep $((tries < 3 ? 2 : 5))

        if [ "$TRANSPORT" = usb ]; then
            # Nothing to reconnect over USB — either the cable is seated or it
            # is not. Waiting beats spinning through the retry budget.
            adb wait-for-device >/dev/null 2>&1 &
            local waiter=$!
            ( sleep 20; kill $waiter 2>/dev/null ) >/dev/null 2>&1 &
            wait $waiter 2>/dev/null
            ADB_SERIAL=$(usb_serial)
            if [ -z "$ADB_SERIAL" ]; then
                usb_denied && usb_perm_hint || usb_missing_hint
                exit 1
            fi
            base[1]=$ADB_SERIAL
        else
            adb disconnect "$(serial)" >/dev/null 2>&1
            if ! connect quiet; then
                # A failed TCP connect after a working session usually means the
                # phone rebooted and dropped out of tcpip mode.
                reboot_hint
                exit 1
            fi
        fi
    done
}

# --- commands --------------------------------------------------------------

# Android 11+ wireless debugging. No cable, ever.
#
# The phone shows TWO different ports: the pairing dialog has its own one-shot
# port, and the main Wireless debugging screen has the connect port. They are
# not the same number, and the connect port is randomised every time wireless
# debugging is toggled. So once paired we immediately ask adbd to also listen
# on the fixed port 5555 — after that the random port stops mattering.
#
# Arch's android-tools is built without mDNS, so `adb mdns services` cannot
# discover the ports for us; they have to be read off the phone screen.
cmd_pair() {
    local pair_hostport=${1:-} code=${2:-} ip conn_port out

    cat <<EOF
On the phone:
  Settings > System > Developer options > ${c_grn}Wireless debugging${c_off}: ON
  Tap ${c_grn}"Pair device with pairing code"${c_off}
  Leave that dialog open — it shows an IP:PORT and a 6-digit code.

EOF
    if [ -z "$pair_hostport" ]; then
        read -rp "IP:PORT from the pairing dialog: " pair_hostport
    fi
    [ -n "$pair_hostport" ] || die "no IP:PORT given"
    ip=${pair_hostport%%:*}
    [ "$ip" != "$pair_hostport" ] || die "expected IP:PORT (e.g. 192.168.1.50:37419), got: $pair_hostport"

    if [ -z "$code" ]; then
        read -rp "6-digit pairing code: " code
    fi
    [ -n "$code" ] || die "no pairing code given"

    out=$(adb pair "$pair_hostport" "$code" 2>&1)
    case "$out" in
        *[Ss]uccessfully*) info "paired with $ip" ;;
        *) warn "$out"; die "pairing failed — the dialog's port and code both change every time it is reopened, so close it, reopen it and use the fresh values." ;;
    esac

    echo
    echo "Now close the pairing dialog. The main Wireless debugging screen shows"
    echo "the phone's address with a ${c_grn}different${c_off} port — that is the connect port."
    echo
    read -rp "Connect port (just the number, after the colon): " conn_port
    [ -n "$conn_port" ] || die "no connect port given"

    out=$(adb connect "${ip}:${conn_port}" 2>&1)
    if ! adb devices | grep -q "^${ip}:${conn_port}[[:space:]]*device"; then
        warn "$out"
        die "could not connect to ${ip}:${conn_port} — re-check the port on the Wireless debugging screen."
    fi
    info "connected on the wireless-debugging port ${conn_port}"

    PHONE_IP=$ip
    save_conf_key PHONE_IP "$ip"

    # Promote to the fixed port so the random one never has to be read again.
    if adb -s "${ip}:${conn_port}" tcpip "$PHONE_PORT" >/dev/null 2>&1 && sleep 2 && connect quiet; then
        save_conf_key PHONE_PORT "$PHONE_PORT"
        info "adbd now also listens on the fixed port ${PHONE_PORT}"
        warn "Port ${PHONE_PORT} does NOT survive a phone reboot. After a reboot, either re-run"
        warn "'pokemirror pair' (pairing itself persists — you only re-enter the connect port) or"
        warn "'pokemirror setup' over USB."
    else
        # Some ROMs refuse `tcpip` over a wireless-debug transport. Fall back to
        # the random port; it just has to be refreshed whenever it changes.
        PHONE_PORT=$conn_port
        save_conf_key PHONE_PORT "$conn_port"
        warn "This ROM would not open port 5555 over wireless debugging; using ${conn_port}."
        warn "That port changes whenever wireless debugging is toggled or the phone reboots —"
        warn "re-run 'pokemirror pair' to refresh it (pairing itself is remembered)."
    fi

    warn "Set a static DHCP lease for ${ip} on the router, or the IP will drift."

    resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO" >/dev/null
    resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket" >/dev/null
    echo
    cmd_status
}

cmd_setup() {
    local usb ip
    info "Looking for a phone over USB…"
    usb=$(usb_serial)
    if [ -z "$usb" ]; then
        cat <<EOF

No USB device in 'adb devices'. Checklist:
  1. Settings > About phone > tap "Build number" 7x  -> Developer options
  2. Developer options > USB debugging: ON
  3. Plug the phone in with a DATA cable, pick "File transfer" if asked
  4. Accept the "Allow USB debugging?" prompt (tick "Always allow")

Then re-run: pokemirror setup
EOF
        exit 1
    fi
    info "USB device: $usb"

    ip=$(adb -s "$usb" shell ip route 2>/dev/null | tr -d '\r' \
         | awk '/wlan[0-9]/ && /src/ {for (i=1;i<=NF;i++) if ($i=="src") print $(i+1)}' | head -1)
    [ -n "$ip" ] || ip=$(adb -s "$usb" shell ip -o -4 addr show 2>/dev/null | tr -d '\r' \
         | awk '/wlan[0-9]/ {split($4,a,"/"); print a[1]; exit}')
    [ -n "$ip" ] || die "could not read the phone's Wi-Fi IP — is Wi-Fi on?"

    info "Phone Wi-Fi IP: $ip"
    warn "Set a static DHCP lease for $ip on the router, or this will drift."

    adb -s "$usb" tcpip "$PHONE_PORT" >/dev/null 2>&1 || die "adb tcpip $PHONE_PORT failed"
    sleep 2

    PHONE_IP=$ip
    save_conf_key PHONE_IP "$ip"
    save_conf_key PHONE_PORT "$PHONE_PORT"

    info "TCP debugging enabled on ${ip}:${PHONE_PORT}. You can unplug the USB cable now."
    info "Note: this does NOT survive a phone reboot — re-run 'pokemirror setup' after one."

    # Resolve and cache package names while the device is definitely reachable.
    connect quiet || return 0
    resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO" >/dev/null
    resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket" >/dev/null
    cmd_status
}

cmd_status() {
    load_conf
    local usb
    usb=$(usb_serial)
    printf 'config     %s\n' "$CONF"
    printf 'display    %s @ %sdpi%s\n' \
        "${PANEL:-<phone native>}" "$DPI" \
        "$([ "$FULLSCREEN" = 1 ] && echo ', fullscreen')"
    printf 'codec      %s\n' "$CODEC"
    printf 'output     %s\n' "${OUTPUT:-<compositor decides>}"
    printf 'audio      %s\n' \
        "$([ "$AUDIO" = 1 ] && echo "-> $(pactl get-default-sink 2>/dev/null || echo 'desktop default sink')" || echo 'off (plays on phone)')"
    printf 'transport  %s\n' "$CONNECTION"
    if [ -n "$usb" ]; then
        printf 'usb        %s %s\n' "$usb" \
            "$([ "$CONNECTION" != tcp ] && echo '(will be used)' || echo '(ignored: CONNECTION=tcp)')"
    elif usb_denied; then
        printf 'usb        %spresent but no permission — not in adbusers yet%s\n' "$c_yel" "$c_off"
    else
        printf 'usb        <not plugged in>\n'
    fi
    printf 'phone      %s\n' "${PHONE_IP:-<unset — run: pokemirror pair (or setup)>}"
    [ -n "$PHONE_IP" ] || { [ -n "$usb" ] && ADB_SERIAL=$usb || return 0; }
    if [ -n "$PHONE_IP" ]; then
        printf 'adb state  %s\n' "$(dev_state)"
        [ "$(dev_state)" = device ] || connect quiet >/dev/null 2>&1 || true
        [ -n "$usb" ] || ADB_SERIAL=$(serial)
    fi
    if [ -n "$ADB_SERIAL" ] && [ -n "$(ash getprop ro.product.model)" ]; then
        printf 'model      %s %s (Android %s)\n' \
            "$(ash getprop ro.product.manufacturer)" \
            "$(ash getprop ro.product.model)" \
            "$(ash getprop ro.build.version.release)"
        printf 'panel      %s @ %sdpi (virtual display uses %s)\n' \
            "$(ash wm size | awk -F': ' '/Physical/{print $2}')" \
            "$(ash wm density | awk -F': ' '/Physical/{print $2}')" "$DPI"
        # Android's thermal status: 0 none, 1 light, 2 moderate, 3 severe,
        # 4 critical, 5 emergency, 6 shutdown. From 3 up the phone is actively
        # throttling, which shows up as microstutters in both streams at once.
        local therm
        therm=$(ash dumpsys thermalservice | awk -F': ' '/Thermal Status/ {print $2; exit}')
        case "${therm:-}" in
            ''|0|1) printf 'thermal    %s\n' "${therm:-unknown}" ;;
            2)      printf 'thermal    %s (moderate)\n' "$therm" ;;
            *)      printf 'thermal    %s%s — THROTTLING%s\n' "$c_yel" "$therm" "$c_off" ;;
        esac
        printf 'pogo       %s\n' "${PKG_POGO:-<unresolved>}"
        printf 'tcgp       %s\n' "${PKG_TCGP:-<unresolved>}"
    fi
}

cmd_apps() {
    ensure_connected || exit 1
    info "Pokémon-ish packages:"
    list_pkgs | grep -iE 'poke|niantic|tcg' || echo "  (none matched)"
}

cmd_config() {
    printf '%s\n\n' "$CONF"
    [ -f "$CONF" ] && cat "$CONF" || echo "(does not exist yet — run: pokemirror setup)"
}

usage() { sed -n '2,64p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    need adb android-tools
    need scrcpy
    load_conf
    case "${1:-}" in
        pair)           shift; cmd_pair "$@" ;;
        setup)          cmd_setup ;;
        pogo|tcgp)      launch "$@" ;;
        duo)            shift; launch_duo "$@" ;;
        connect)        connect ;;
        status|"")      cmd_status ;;
        apps)           cmd_apps ;;
        config)         cmd_config ;;
        -h|--help|help) usage ;;
        *)              die "unknown command: $1  (try: pokemirror --help)" ;;
    esac
}

main "$@"
