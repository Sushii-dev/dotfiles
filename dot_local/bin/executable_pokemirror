#!/usr/bin/env bash
# pokemirror — mirror a real Android phone to the desktop with scrcpy, for
# playing portrait-locked Pokémon titles (Pokémon GO, Pokémon TCG Pocket).
#
# The games run on the phone: real GPS, real Play Integrity attestation.
# The desktop is display + input only. No automation, no macros, no scripted
# taps — those are bannable in both titles and this script will never add them.
#
# Usage:
#   pokemirror pair           one-time WIRELESS pairing (Android 11+, no cable)
#   pokemirror setup          one-time USB pairing: enables adb over TCP, saves IP
#   pokemirror pogo           launch Pokémon GO   (latency profile)
#   pokemirror tcgp           launch TCG Pocket   (smoothness profile)
#   pokemirror connect        connect adb over TCP only
#   pokemirror status         show connection, resolved packages, panel size
#   pokemirror apps           list Pokémon-ish packages on the phone
#   pokemirror config         print the config file path and contents
#
# Config: ~/.config/pokemirror/config  (host-specific, NOT tracked by chezmoi)
#   PHONE_IP=192.168.1.50
#   PHONE_PORT=5555
#   PKG_POGO=com.nianticlabs.pokemongo
#   PKG_TCGP=jp.pokemon.pokemontcgp
#   CONNECTION=auto          # auto | usb | tcp — auto prefers USB when plugged in
#   CODEC=h265               # h264 decodes a touch faster on some setups
#   OUTPUT=DP-1              # KDE only: pin the window to this connector
#                            #   (under niri the window rule in config.kdl does this)
#   PANEL=1080x1920          # virtual display size; default = phone's native panel
#   DPI=420                  # lower = smaller UI = more content on screen
#   FULLSCREEN=1             # 1 -> scrcpy opens fullscreen (pairs with PANEL=output size)
#   VD_DECORATIONS=0         # 1 -> drop --no-vd-system-decorations
#   EXTRA_ARGS=              # appended verbatim to every scrcpy invocation
#
# USB is the low-latency transport. Wi-Fi adds jitter that shows up exactly
# where it hurts — Pokémon GO ball throws — and drops the link when the phone
# roams or dozes. Under CONNECTION=auto a plugged-in phone always wins, and the
# bit rate is raised because USB bandwidth is free.
#
# To fill a portrait monitor edge to edge, set PANEL to the monitor's ROTATED
# logical size and turn FULLSCREEN on — e.g. a 1920x1080 panel mounted at 90°
# is logically 1080x1920, so PANEL=1080x1920 renders 1:1 with no rescaling.
# Extra args can also be passed per launch: pokemirror pogo --print-fps

set -uo pipefail

CONF_KEYS='CONNECTION|CODEC|PANEL|DPI|FULLSCREEN|VD_DECORATIONS|EXTRA_ARGS|PHONE_IP|PHONE_PORT|PKG_POGO|PKG_TCGP|OUTPUT'

# Snapshot deliberate one-off overrides (CONNECTION=usb pokemirror pogo) BEFORE
# the defaults below are assigned. Assigning to an already-exported name would
# overwrite the environment too, so capturing any later than this loses them.
ENV_OVERRIDES=$(printenv | grep -E "^(${CONF_KEYS})=" || true)

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pokemirror"
CONF="$CONF_DIR/config"

PHONE_PORT=5555
DPI=420
FULLSCREEN=0
VD_DECORATIONS=0
PANEL=""
PHONE_IP=""
PKG_POGO=""
PKG_TCGP=""
EXTRA_ARGS=""
CONNECTION=auto     # auto | usb | tcp
CODEC=h265
OUTPUT=""           # KDE only: connector name to pin the window to, e.g. DP-1

# Resolved by pick_transport().
TRANSPORT=""
ADB_SERIAL=""

# Package name patterns. Names are resolved on the device at runtime; these are
# only search patterns, never assumed to be the real package id.
PAT_POGO='nianticlabs\.pokemongo|com\.pokemongo|pokemongo'
PAT_TCGP='pokemontcgp|pokemon.*tcg|tcg.*pocket'

# scrcpy exit codes: 0 success, 1 failure, 2 device disconnected.
EXIT_DISCONNECTED=2

RECONNECT_TRIES=5

c_red=$'\033[31m'; c_yel=$'\033[33m'; c_grn=$'\033[32m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
info()  { printf '%s==>%s %s\n' "$c_grn" "$c_off" "$*"; }
warn()  { printf '%s==>%s %s\n' "$c_yel" "$c_off" "$*" >&2; }
die()   { printf '%s==>%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }
dim()   { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 not installed (pacman -S ${2:-$1})"; }

load_conf() {
    local kv
    if [ -f "$CONF" ]; then
        # shellcheck disable=SC1090
        source "$CONF"
    fi
    # Environment beats the config file, so one-off overrides actually apply.
    while IFS= read -r kv; do
        [ -n "$kv" ] && declare -g "$kv"
    done <<< "$ENV_OVERRIDES"
}

save_conf_key() {
    local key=$1 val=$2
    mkdir -p "$CONF_DIR"
    touch "$CONF"
    if grep -q "^${key}=" "$CONF" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONF"
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONF"
    fi
}

serial() { printf '%s:%s' "$PHONE_IP" "$PHONE_PORT"; }

# --- connection ------------------------------------------------------------

# Prints the device state for the TCP serial: device | offline | unauthorized | absent
dev_state() {
    local s
    s=$(adb devices | awk -v d="$(serial)" '$1==d {print $2}')
    printf '%s' "${s:-absent}"
}

usb_serial() {
    adb devices | awk '$2=="device" && $1 !~ /:/ {print $1; exit}'
}

# A USB device visible to the kernel but not to us — the udev rules from
# android-udev grant access via the adbusers group, and group membership only
# takes effect on a fresh login.
usb_denied() {
    adb devices 2>/dev/null | grep -q 'no permissions'
}

usb_perm_hint() {
    cat >&2 <<EOF

${c_yel}A phone is plugged in but adb has no permission to talk to it.${c_off}
android-udev grants access through the 'adbusers' group. You are currently in:
    $(id -nG)

Fix it permanently by logging out and back in (group membership is set at login).
To use it right now, in the terminal you launch pokemirror from:

    adb kill-server
    newgrp adbusers

then re-run pokemirror inside that subshell.
EOF
}

usb_missing_hint() {
    cat >&2 <<EOF

${c_yel}No USB phone in 'adb devices'.${c_off}
  - use a DATA cable, not a charge-only one
  - if a mode picker appears on the phone, choose "File transfer"
  - Developer options > USB debugging must be ON
  - accept the "Allow USB debugging?" prompt (tick "Always allow")

Or set CONNECTION=tcp in ${CONF} to go back over Wi-Fi.
EOF
}

# Decides which transport to use and sets TRANSPORT + ADB_SERIAL.
# USB is preferred under 'auto': no Wi-Fi jitter, and bandwidth is free.
pick_transport() {
    local usb
    case "$CONNECTION" in
        usb)
            usb=$(usb_serial)
            if [ -z "$usb" ]; then
                usb_denied && { usb_perm_hint; return 1; }
                usb_missing_hint; return 1
            fi
            TRANSPORT=usb; ADB_SERIAL=$usb ;;
        tcp)
            ensure_connected || return 1
            TRANSPORT=tcp; ADB_SERIAL=$(serial) ;;
        auto)
            usb=$(usb_serial)
            if [ -n "$usb" ]; then
                TRANSPORT=usb; ADB_SERIAL=$usb
            else
                usb_denied && usb_perm_hint
                ensure_connected || return 1
                TRANSPORT=tcp; ADB_SERIAL=$(serial)
            fi ;;
        *) die "CONNECTION must be auto, usb or tcp (got: $CONNECTION)" ;;
    esac
}

reboot_hint() {
    cat >&2 <<EOF

${c_yel}Phone is not listening on TCP port ${PHONE_PORT}.${c_off}
adb's TCP mode does not survive a phone reboot. Plug the phone in over USB and:

    pokemirror setup

(or manually: adb tcpip ${PHONE_PORT}, then unplug)
EOF
}

connect() {
    local quiet=${1:-}
    [ -n "$PHONE_IP" ] || die "PHONE_IP not set — run: pokemirror setup"

    case "$(dev_state)" in
        device) [ -n "$quiet" ] || info "already connected to $(serial)"; return 0 ;;
        offline|unauthorized) adb disconnect "$(serial)" >/dev/null 2>&1 ;;
    esac

    local out
    out=$(adb connect "$(serial)" 2>&1)
    if [ "$(dev_state)" = device ]; then
        [ -n "$quiet" ] || info "connected to $(serial)"
        return 0
    fi

    case "$out" in
        *unauthorized*)
            warn "$out"
            die "Phone shows an 'Allow USB debugging?' prompt — accept it (tick 'Always allow'), then retry." ;;
        *)
            warn "$out"
            reboot_hint
            return 1 ;;
    esac
}

ensure_connected() {
    connect quiet && return 0
    return 1
}

# --- device queries --------------------------------------------------------

ash() { adb -s "${ADB_SERIAL:-$(serial)}" shell "$@" 2>/dev/null | tr -d '\r'; }

panel_size() {
    [ -n "$PANEL" ] && { printf '%s' "$PANEL"; return 0; }
    # "Physical size: 1080x2400" (+ optionally "Override size: ...")
    local s
    s=$(ash wm size | awk -F': ' '/Physical size/ {print $2; exit}')
    [ -n "$s" ] || return 1
    printf '%s' "$s"
}

list_pkgs() {
    ash pm list packages | sed 's/^package://'
}

resolve_pkg() {
    local pattern=$1
    list_pkgs | grep -iE "$pattern" | head -1
}

# resolve_and_cache <conf_key> <current_value> <pattern> <label>
resolve_and_cache() {
    local key=$1 cur=$2 pattern=$3 label=$4 pkg
    if [ -n "$cur" ] && list_pkgs | grep -qxF "$cur"; then
        printf '%s' "$cur"; return 0
    fi
    pkg=$(resolve_pkg "$pattern")
    if [ -z "$pkg" ]; then
        warn "$label not found on the phone. Installed Pokémon-ish packages:"
        list_pkgs | grep -iE 'poke|niantic' >&2 || echo "  (none)" >&2
        return 1
    fi
    save_conf_key "$key" "$pkg"
    printf '%s' "$pkg"
}

# --- window placement ------------------------------------------------------
#
# Wayland clients cannot place their own windows, so scrcpy's --fullscreen lands
# on whatever output the compositor chose. Under niri a window rule handles it.
# Under KWin the equivalent is a scripting call: a kwinrulesrc `screen=` rule
# does NOT work here, because scrcpy is already fullscreen by the time the rule
# would apply and KWin just pins it to the wrong output.
#
# sendClientToScreen only takes effect while the window is NOT fullscreen, and
# the fullScreen write round-trips to the client asynchronously, so this drops
# fullscreen, moves, and re-applies it — then repeats, because the window may
# not exist yet when scrcpy is still pushing its server jar.

kwin_present() { busctl --user status org.kde.KWin >/dev/null 2>&1; }

kwin_place_once() {
    local target=$1 js id
    js=$(mktemp --tmpdir pokemirror-place-XXXXXX.js)
    cat > "$js" <<EOF
const TARGET = "${target}";
let scr = null;
for (const s of workspace.screens) { if (s.name === TARGET) scr = s; }
if (scr) {
  for (const w of workspace.windowList()) {
    if ((w.resourceClass || "").toString().indexOf("scrcpy") === -1) continue;
    if (w.output && w.output.name === TARGET && w.fullScreen) continue;
    w.fullScreen = false;
    workspace.sendClientToScreen(w, scr);
    w.fullScreen = true;
  }
}
EOF
    id=$(busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting \
            loadScript ss "$js" "pokemirror-place" 2>/dev/null | awk '{print $2}')
    if [ -n "$id" ]; then
        busctl --user call "org.kde.KWin" "/Scripting/Script${id}" \
            org.kde.kwin.Script run >/dev/null 2>&1
        busctl --user call org.kde.KWin /Scripting org.kde.kwin.Scripting \
            unloadScript s "pokemirror-place" >/dev/null 2>&1
    fi
    rm -f "$js"
}

# Fire and forget: scrcpy blocks in the foreground, so the placer runs behind it.
kwin_place_async() {
    local target=$1
    [ -n "$target" ] || return 0
    kwin_present || return 0
    (
        for delay in 2 2 3 4; do
            sleep "$delay"
            kwin_place_once "$target"
        done
    ) >/dev/null 2>&1 &
}

# --- profiles --------------------------------------------------------------

launch() {
    local profile=$1 pkg res title args=()
    shift
    local cli_args=("$@")   # anything after the profile goes straight to scrcpy

    pick_transport || exit 1

    res=$(panel_size) || die "could not read the phone's panel size (adb shell wm size)"

    # Over USB there is bandwidth to spare, so spend it on picture quality; over
    # Wi-Fi a fatter stream is the first thing to stutter when the link dips.
    local rate_hi rate_lo
    if [ "$TRANSPORT" = usb ]; then rate_hi=16M; rate_lo=12M; else rate_hi=8M; rate_lo=6M; fi

    case "$profile" in
        pogo)
            pkg=$(resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO") || exit 1
            title="Pokémon GO"
            # Latency critical: ball throws are timing-sensitive, so no buffer.
            args=(--video-buffer=0 --video-bit-rate="$rate_hi")
            ;;
        tcgp)
            pkg=$(resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket") || exit 1
            title="Pokémon TCG Pocket"
            # Turn based: trade latency for a smoother pack-opening animation.
            args=(--video-buffer=50 --video-bit-rate="$rate_lo")
            ;;
        *) die "unknown profile: $profile" ;;
    esac

    local base=(
        -s "$ADB_SERIAL"
        --video-codec="$CODEC"
        --max-fps=60
        --no-audio
        --new-display="${res}/${DPI}"
        --start-app="$pkg"
        --window-title="$title"
    )
    [ "$VD_DECORATIONS" = 1 ] || base+=(--no-vd-system-decorations)
    [ "$FULLSCREEN" = 1 ] && base+=(--fullscreen)
    # shellcheck disable=SC2206
    [ -n "$EXTRA_ARGS" ] && base+=($EXTRA_ARGS)
    [ ${#cli_args[@]} -gt 0 ] && base+=("${cli_args[@]}")

    info "$title — ${TRANSPORT^^} ${ADB_SERIAL} — ${res} @ ${DPI}dpi$([ "$FULLSCREEN" = 1 ] && echo ' — fullscreen') — $pkg"
    dim "  scrcpy ${base[*]} ${args[*]}"

    local tries=0 rc
    while :; do
        kwin_place_async "$OUTPUT"
        scrcpy "${base[@]}" "${args[@]}"
        rc=$?
        [ $rc -eq 0 ] && { info "closed"; return 0; }

        tries=$((tries + 1))
        if [ $tries -gt $RECONNECT_TRIES ]; then
            die "gave up after $RECONNECT_TRIES reconnect attempts (last exit $rc)"
        fi

        if [ $rc -eq $EXIT_DISCONNECTED ]; then
            warn "device disconnected — reconnecting (${tries}/${RECONNECT_TRIES})"
        else
            warn "scrcpy exited $rc — retrying (${tries}/${RECONNECT_TRIES})"
        fi

        sleep $((tries < 3 ? 2 : 5))

        if [ "$TRANSPORT" = usb ]; then
            # Nothing to reconnect over USB — either the cable is seated or it
            # is not. Waiting beats spinning through the retry budget.
            adb wait-for-device >/dev/null 2>&1 &
            local waiter=$!
            ( sleep 20; kill $waiter 2>/dev/null ) >/dev/null 2>&1 &
            wait $waiter 2>/dev/null
            ADB_SERIAL=$(usb_serial)
            if [ -z "$ADB_SERIAL" ]; then
                usb_denied && usb_perm_hint || usb_missing_hint
                exit 1
            fi
            base[1]=$ADB_SERIAL
        else
            adb disconnect "$(serial)" >/dev/null 2>&1
            if ! connect quiet; then
                # A failed TCP connect after a working session usually means the
                # phone rebooted and dropped out of tcpip mode.
                reboot_hint
                exit 1
            fi
        fi
    done
}

# --- commands --------------------------------------------------------------

# Android 11+ wireless debugging. No cable, ever.
#
# The phone shows TWO different ports: the pairing dialog has its own one-shot
# port, and the main Wireless debugging screen has the connect port. They are
# not the same number, and the connect port is randomised every time wireless
# debugging is toggled. So once paired we immediately ask adbd to also listen
# on the fixed port 5555 — after that the random port stops mattering.
#
# Arch's android-tools is built without mDNS, so `adb mdns services` cannot
# discover the ports for us; they have to be read off the phone screen.
cmd_pair() {
    local pair_hostport=${1:-} code=${2:-} ip conn_port out

    cat <<EOF
On the phone:
  Settings > System > Developer options > ${c_grn}Wireless debugging${c_off}: ON
  Tap ${c_grn}"Pair device with pairing code"${c_off}
  Leave that dialog open — it shows an IP:PORT and a 6-digit code.

EOF
    if [ -z "$pair_hostport" ]; then
        read -rp "IP:PORT from the pairing dialog: " pair_hostport
    fi
    [ -n "$pair_hostport" ] || die "no IP:PORT given"
    ip=${pair_hostport%%:*}
    [ "$ip" != "$pair_hostport" ] || die "expected IP:PORT (e.g. 192.168.1.50:37419), got: $pair_hostport"

    if [ -z "$code" ]; then
        read -rp "6-digit pairing code: " code
    fi
    [ -n "$code" ] || die "no pairing code given"

    out=$(adb pair "$pair_hostport" "$code" 2>&1)
    case "$out" in
        *[Ss]uccessfully*) info "paired with $ip" ;;
        *) warn "$out"; die "pairing failed — the dialog's port and code both change every time it is reopened, so close it, reopen it and use the fresh values." ;;
    esac

    echo
    echo "Now close the pairing dialog. The main Wireless debugging screen shows"
    echo "the phone's address with a ${c_grn}different${c_off} port — that is the connect port."
    echo
    read -rp "Connect port (just the number, after the colon): " conn_port
    [ -n "$conn_port" ] || die "no connect port given"

    out=$(adb connect "${ip}:${conn_port}" 2>&1)
    if ! adb devices | grep -q "^${ip}:${conn_port}[[:space:]]*device"; then
        warn "$out"
        die "could not connect to ${ip}:${conn_port} — re-check the port on the Wireless debugging screen."
    fi
    info "connected on the wireless-debugging port ${conn_port}"

    PHONE_IP=$ip
    save_conf_key PHONE_IP "$ip"

    # Promote to the fixed port so the random one never has to be read again.
    if adb -s "${ip}:${conn_port}" tcpip "$PHONE_PORT" >/dev/null 2>&1 && sleep 2 && connect quiet; then
        save_conf_key PHONE_PORT "$PHONE_PORT"
        info "adbd now also listens on the fixed port ${PHONE_PORT}"
        warn "Port ${PHONE_PORT} does NOT survive a phone reboot. After a reboot, either re-run"
        warn "'pokemirror pair' (pairing itself persists — you only re-enter the connect port) or"
        warn "'pokemirror setup' over USB."
    else
        # Some ROMs refuse `tcpip` over a wireless-debug transport. Fall back to
        # the random port; it just has to be refreshed whenever it changes.
        PHONE_PORT=$conn_port
        save_conf_key PHONE_PORT "$conn_port"
        warn "This ROM would not open port 5555 over wireless debugging; using ${conn_port}."
        warn "That port changes whenever wireless debugging is toggled or the phone reboots —"
        warn "re-run 'pokemirror pair' to refresh it (pairing itself is remembered)."
    fi

    warn "Set a static DHCP lease for ${ip} on the router, or the IP will drift."

    resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO" >/dev/null
    resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket" >/dev/null
    echo
    cmd_status
}

cmd_setup() {
    local usb ip
    info "Looking for a phone over USB…"
    usb=$(usb_serial)
    if [ -z "$usb" ]; then
        cat <<EOF

No USB device in 'adb devices'. Checklist:
  1. Settings > About phone > tap "Build number" 7x  -> Developer options
  2. Developer options > USB debugging: ON
  3. Plug the phone in with a DATA cable, pick "File transfer" if asked
  4. Accept the "Allow USB debugging?" prompt (tick "Always allow")

Then re-run: pokemirror setup
EOF
        exit 1
    fi
    info "USB device: $usb"

    ip=$(adb -s "$usb" shell ip route 2>/dev/null | tr -d '\r' \
         | awk '/wlan[0-9]/ && /src/ {for (i=1;i<=NF;i++) if ($i=="src") print $(i+1)}' | head -1)
    [ -n "$ip" ] || ip=$(adb -s "$usb" shell ip -o -4 addr show 2>/dev/null | tr -d '\r' \
         | awk '/wlan[0-9]/ {split($4,a,"/"); print a[1]; exit}')
    [ -n "$ip" ] || die "could not read the phone's Wi-Fi IP — is Wi-Fi on?"

    info "Phone Wi-Fi IP: $ip"
    warn "Set a static DHCP lease for $ip on the router, or this will drift."

    adb -s "$usb" tcpip "$PHONE_PORT" >/dev/null 2>&1 || die "adb tcpip $PHONE_PORT failed"
    sleep 2

    PHONE_IP=$ip
    save_conf_key PHONE_IP "$ip"
    save_conf_key PHONE_PORT "$PHONE_PORT"

    info "TCP debugging enabled on ${ip}:${PHONE_PORT}. You can unplug the USB cable now."
    info "Note: this does NOT survive a phone reboot — re-run 'pokemirror setup' after one."

    # Resolve and cache package names while the device is definitely reachable.
    connect quiet || return 0
    resolve_and_cache PKG_POGO "$PKG_POGO" "$PAT_POGO" "Pokémon GO" >/dev/null
    resolve_and_cache PKG_TCGP "$PKG_TCGP" "$PAT_TCGP" "Pokémon TCG Pocket" >/dev/null
    cmd_status
}

cmd_status() {
    load_conf
    local usb
    usb=$(usb_serial)
    printf 'config     %s\n' "$CONF"
    printf 'display    %s @ %sdpi%s\n' \
        "${PANEL:-<phone native>}" "$DPI" \
        "$([ "$FULLSCREEN" = 1 ] && echo ', fullscreen')"
    printf 'codec      %s\n' "$CODEC"
    printf 'output     %s\n' "${OUTPUT:-<compositor decides>}"
    printf 'transport  %s\n' "$CONNECTION"
    if [ -n "$usb" ]; then
        printf 'usb        %s %s\n' "$usb" \
            "$([ "$CONNECTION" != tcp ] && echo '(will be used)' || echo '(ignored: CONNECTION=tcp)')"
    elif usb_denied; then
        printf 'usb        %spresent but no permission — not in adbusers yet%s\n' "$c_yel" "$c_off"
    else
        printf 'usb        <not plugged in>\n'
    fi
    printf 'phone      %s\n' "${PHONE_IP:-<unset — run: pokemirror pair (or setup)>}"
    [ -n "$PHONE_IP" ] || { [ -n "$usb" ] && ADB_SERIAL=$usb || return 0; }
    if [ -n "$PHONE_IP" ]; then
        printf 'adb state  %s\n' "$(dev_state)"
        [ "$(dev_state)" = device ] || connect quiet >/dev/null 2>&1 || true
        [ -n "$usb" ] || ADB_SERIAL=$(serial)
    fi
    if [ -n "$ADB_SERIAL" ] && [ -n "$(ash getprop ro.product.model)" ]; then
        printf 'model      %s %s (Android %s)\n' \
            "$(ash getprop ro.product.manufacturer)" \
            "$(ash getprop ro.product.model)" \
            "$(ash getprop ro.build.version.release)"
        printf 'panel      %s @ %sdpi (virtual display uses %s)\n' \
            "$(ash wm size | awk -F': ' '/Physical/{print $2}')" \
            "$(ash wm density | awk -F': ' '/Physical/{print $2}')" "$DPI"
        printf 'pogo       %s\n' "${PKG_POGO:-<unresolved>}"
        printf 'tcgp       %s\n' "${PKG_TCGP:-<unresolved>}"
    fi
}

cmd_apps() {
    ensure_connected || exit 1
    info "Pokémon-ish packages:"
    list_pkgs | grep -iE 'poke|niantic|tcg' || echo "  (none matched)"
}

cmd_config() {
    printf '%s\n\n' "$CONF"
    [ -f "$CONF" ] && cat "$CONF" || echo "(does not exist yet — run: pokemirror setup)"
}

usage() { sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    need adb android-tools
    need scrcpy
    load_conf
    case "${1:-}" in
        pair)           shift; cmd_pair "$@" ;;
        setup)          cmd_setup ;;
        pogo|tcgp)      launch "$@" ;;
        connect)        connect ;;
        status|"")      cmd_status ;;
        apps)           cmd_apps ;;
        config)         cmd_config ;;
        -h|--help|help) usage ;;
        *)              die "unknown command: $1  (try: pokemirror --help)" ;;
    esac
}

main "$@"
