#!/usr/bin/env bash
# wallpaper-engine-import — link Wallpaper Engine "Video"-type Workshop items into
# the video wallpaper library so the picker / Smart Video Reborn can use them.
#
# Only Video-type items are plain media files this engine can play. Scene, Web and
# Application items are skipped (they need linux-wallpaperengine, a layer-shell
# daemon that fights plasmashell — better suited to the niri session).
#
# Requires Wallpaper Engine (Steam app 431960) installed and items subscribed; you
# do NOT need to run WE — Steam downloads subscribed Workshop content on its own.
set -euo pipefail

VID_DIR="$HOME/.local/share/wallpapers-video"

# Allow an explicit workshop dir override (used by tests): arg 1.
ws="${1:-}"
if [ -z "$ws" ]; then
    for base in "$HOME/.local/share/Steam" "$HOME/.steam/steam" \
                /mnt/Tsukiji/SteamLibrary /mnt/Noren/SteamLibrary /mnt/*/SteamLibrary; do
        d="$base/steamapps/workshop/content/431960"
        [ -d "$d" ] && { ws="$d"; break; }
    done
fi

if [ -z "$ws" ] || [ ! -d "$ws" ]; then
    cat >&2 <<'MSG'
wallpaper-engine-import: no Wallpaper Engine workshop dir found.
  1. Install Wallpaper Engine on Steam (app 431960, paid).
  2. Subscribe to wallpapers in the Workshop — filter by Type: Video.
  3. Let Steam download them, then re-run this.
MSG
    exit 1
fi

mkdir -p "$VID_DIR"
linked=0 skipped=0
for item in "$ws"/*/; do
    pj="$item/project.json"
    [ -f "$pj" ] || continue
    type="$(jq -r '.type // empty' "$pj" 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    if [ "$type" != "video" ]; then
        skipped=$((skipped + 1))
        continue
    fi
    file="$(jq -r '.file // empty' "$pj" 2>/dev/null)"
    [ -n "$file" ] && [ -f "$item/$file" ] || { skipped=$((skipped + 1)); continue; }
    id="$(basename "$item")"
    title="$(jq -r '.title // "wallpaper-engine"' "$pj" 2>/dev/null | tr -cs '[:alnum:]' '_' | sed 's/_*$//' | cut -c1-50)"
    # id suffix keeps titles unique and lets re-runs be idempotent
    ln -sf "$item/$file" "$VID_DIR/${title}-${id}.${file##*.}"
    linked=$((linked + 1))
done

echo "wallpaper-engine-import: linked $linked Video-type wallpaper(s), skipped $skipped non-video item(s) -> $VID_DIR"
[ "$linked" = 0 ] && echo "(no Video-type items — Scene/Web/Application items aren't supported by Smart Video Reborn)"
exit 0
