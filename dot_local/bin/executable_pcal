#!/usr/bin/env python3
"""pcal — Proton Calendar events via the official "Share with anyone → Full view" ICS link.

Proton has no CalDAV and Bridge gives no calendar data; the share-link .ics (its
decryption key is in the URL) is the only ToS-safe path. Read-only, refreshes slowly
Proton-side, so we cache locally and poll on a timer.

Config (UNTRACKED, never chezmoi): ~/.config/proton-calendar/credentials
  one calendar per line, "Label=https://calendar.proton.me/api/calendar/v1/url/.../calendar.ics?..."
  (a bare URL with no "Label=" is also accepted; label defaults to "Proton")

Usage:
  pcal day   [YYYY-MM-DD]     events for a day   (default: today)
  pcal week  [YYYY-MM-DD]     events for the ISO week containing the date
  pcal month [YYYY-MM]        events for a month (default: current)
  pcal events --from D --to D events in an explicit [from, to) range
  pcal refresh               force re-fetch all calendars now
Options: --refresh (bypass cache), --ttl SECONDS (cache age, default 1800)
Output: JSON array of {title,start,end,allDay,location,calendar} sorted by start.
"""
import argparse
import calendar as _cal
import datetime as dt
import hashlib
import json
import os
import sys
import urllib.request

CRED = os.path.expanduser("~/.config/proton-calendar/credentials")
CACHE = os.path.expanduser("~/.cache/proton-calendar")

try:
    import icalendar
    import recurring_ical_events
except ImportError:
    sys.exit("missing deps: pacman -S python-icalendar python-recurring-ical-events")


def load_calendars():
    cals = []
    if not os.path.exists(CRED):
        sys.exit(f"no calendars configured: create {CRED} (Label=ICS_URL per line)")
    with open(CRED) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" in line and line.split("=", 1)[1].startswith("http"):
                label, url = line.split("=", 1)
            else:
                label, url = "Proton", line
            cals.append((label.strip(), url.strip()))
    if not cals:
        sys.exit(f"no calendar URLs in {CRED}")
    return cals


def fetch(url, ttl, force):
    os.makedirs(CACHE, exist_ok=True)
    key = hashlib.sha256(url.encode()).hexdigest()[:16]
    path = os.path.join(CACHE, key + ".ics")
    fresh = (not force and os.path.exists(path)
             and (dt.datetime.now().timestamp() - os.path.getmtime(path)) < ttl)
    if fresh:
        with open(path, "rb") as fh:
            return fh.read()
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "pcal/1.0"})
        with urllib.request.urlopen(req, timeout=20) as r:
            data = r.read()
        tmp = path + ".tmp"
        with open(tmp, "wb") as fh:
            fh.write(data)
        os.replace(tmp, path)
        return data
    except Exception as e:
        if os.path.exists(path):          # serve stale on network failure
            sys.stderr.write(f"pcal: fetch failed ({e}); using cached\n")
            with open(path, "rb") as fh:
                return fh.read()
        raise


def _iso(v):
    """DTSTART/DTEND .dt -> (iso_string, is_all_day)."""
    if isinstance(v, dt.datetime):
        if v.tzinfo is not None:
            v = v.astimezone()          # to local tz
        return v.replace(microsecond=0).isoformat(), False
    if isinstance(v, dt.date):
        return v.isoformat(), True
    return str(v), False


def collect(start, end, ttl, force):
    out = []
    for label, url in load_calendars():
        try:
            ics = fetch(url, ttl, force)
            cal = icalendar.Calendar.from_ical(ics)
            for ev in recurring_ical_events.of(cal).between(start, end):
                ds = ev.get("DTSTART")
                de = ev.get("DTEND")
                if ds is None:
                    continue
                start_iso, all_day = _iso(ds.dt)
                end_iso = _iso(de.dt)[0] if de is not None else start_iso
                out.append({
                    "title": str(ev.get("SUMMARY", "(no title)")),
                    "start": start_iso,
                    "end": end_iso,
                    "allDay": all_day,
                    "location": str(ev.get("LOCATION", "") or ""),
                    "calendar": label,
                })
        except Exception as e:
            sys.stderr.write(f"pcal: calendar '{label}' failed: {e}\n")
    out.sort(key=lambda e: e["start"])
    return out


def parse_date(s):
    return dt.date.fromisoformat(s)


def main():
    p = argparse.ArgumentParser(prog="pcal")
    p.add_argument("--ttl", type=int, default=1800)
    p.add_argument("--refresh", action="store_true")
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("day"); d.add_argument("date", nargs="?")
    w = sub.add_parser("week"); w.add_argument("date", nargs="?")
    m = sub.add_parser("month"); m.add_argument("month", nargs="?", help="YYYY-MM")
    e = sub.add_parser("events"); e.add_argument("--from", dest="frm", required=True); e.add_argument("--to", required=True)
    sub.add_parser("refresh")
    args = p.parse_args()
    today = dt.date.today()

    if args.cmd == "refresh":
        collect(today, today + dt.timedelta(days=1), args.ttl, True)
        print(json.dumps({"refreshed": True}))
        return
    if args.cmd == "day":
        s = parse_date(args.date) if args.date else today
        rng = (s, s + dt.timedelta(days=1))
    elif args.cmd == "week":
        base = parse_date(args.date) if args.date else today
        s = base - dt.timedelta(days=base.weekday())          # Monday
        rng = (s, s + dt.timedelta(days=7))
    elif args.cmd == "month":
        if args.month:
            y, mo = map(int, args.month.split("-"))
        else:
            y, mo = today.year, today.month
        last = _cal.monthrange(y, mo)[1]
        rng = (dt.date(y, mo, 1), dt.date(y, mo, last) + dt.timedelta(days=1))
    else:  # events
        rng = (parse_date(args.frm), parse_date(args.to))

    print(json.dumps(collect(rng[0], rng[1], args.ttl, args.refresh),
                     ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
