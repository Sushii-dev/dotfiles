#!/usr/bin/env python3
"""Merge Claude settings.json: union permissions, existing device config wins on conflicts."""
import json
import sys

# Base permissions shared across all devices
BASE_ALLOW = [
    # File operations
    "Bash(cat:*)",
    "Bash(ls:*)",
    "Bash(mkdir:*)",
    "Bash(find:*)",
    "Bash(chmod:*)",
    "Bash(cp:*)",
    "Bash(file:*)",
    "Bash(du:*)",
    "Bash(unzip:*)",
    "Bash(tar:*)",
    "Bash(tee:*)",
    "Bash(echo:*)",
    "Bash(printf:*)",
    "Bash(xargs:*)",
    "Bash(sudo mkdir:*)",
    "Bash(sudo ln:*)",
    # Shell & scripting
    "Bash(done)",
    "Bash(cd:*)",
    "Bash(source:*)",
    "Bash(fish:*)",
    "Bash(python3:*)",
    "Bash(pip:*)",
    "Bash(pip3:*)",
    "Bash(curl:*)",
    "Bash(grep:*)",
    # Process & system
    "Bash(kill:*)",
    "Bash(ps:*)",
    "Bash(pgrep:*)",
    "Bash(lscpu:*)",
    # System diagnostics
    "Bash(dmesg:*)",
    "Bash(sudo dmesg:*)",
    "Bash(lsmod:*)",
    "Bash(lsblk:*)",
    "Bash(lsusb:*)",
    "Bash(mount:*)",
    "Bash(sudo mount:*)",
    "Bash(udevadm info:*)",
    "Bash(ping:*)",
    # Package management (Arch)
    "Bash(pacman:*)",
    "Bash(sudo pacman:*)",
    "Bash(paru:*)",
    "Bash(paru -Ss:*)",
    "Bash(paru -Si:*)",
    # Systemd
    "Bash(systemctl:*)",
    "Bash(systemctl status:*)",
    "Bash(systemctl --user restart:*)",
    "Bash(journalctl:*)",
    # Git
    "Bash(git pull:*)",
    "Bash(git clone:*)",
    "Bash(git fetch:*)",
    "Bash(git log:*)",
    "Bash(git remote add:*)",
    # Docker
    "Bash(docker:*)",
    # Tools
    "Bash(tree:*)",
    "Bash(ip:*)",
    "Bash(fastfetch:*)",
    "Bash(udisksctl mount:*)",
    "Bash(gh api:*)",
    "Bash(gh release:*)",
    "Bash(~/.claude-context/update-claude-md.sh)",
    # Web
    "WebSearch",
    "WebFetch(domain:github.com)",
    "WebFetch(domain:raw.githubusercontent.com)",
    "WebFetch(domain:aur.archlinux.org)",
]

BASE_SETTINGS = {
    "effortLevel": "high",
    "statusLine": {
        "type": "command",
        "command": "bash \"/home/sushii/.claude/hooks/statusline.sh\"",
    },
}

# Read existing config from stdin (chezmoi passes current file contents)
existing_raw = sys.stdin.read().strip()

if existing_raw:
    existing = json.loads(existing_raw)
else:
    existing = {}

# Ensure structure
if "permissions" not in existing:
    existing["permissions"] = {}
if "allow" not in existing["permissions"]:
    existing["permissions"]["allow"] = []

# Merge: add base permissions that don't already exist
existing_allow = set(existing["permissions"]["allow"])
for perm in BASE_ALLOW:
    if perm not in existing_allow:
        existing["permissions"]["allow"].append(perm)

# Set base settings only if not already set (device wins)
for key, value in BASE_SETTINGS.items():
    if key not in existing:
        existing[key] = value

print(json.dumps(existing, indent=2))
