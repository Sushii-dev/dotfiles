#!/usr/bin/env python3
"""Merge cursor size into kcminputrc, preserving per-device Libinput sections."""
import sys

# Keys are FULL literal section headers, so multi-level groups like
# [Libinput][Defaults][Pointer] work as-is.
#
# Why the Defaults blocks exist: KWin keys per-device input config on an EXACT
# triple -- [Libinput][<decimal vendor>][<decimal product>][<verbatim name>] --
# with no fuzzy fallback (kwin/src/backends/libinput/connection.cpp,
# applyDeviceConfig). Swap a mouse, or have one enumerate under a second PID,
# and the old stanza silently orphans and the device falls back to libinput's
# ADAPTIVE acceleration. That is exactly what happened here: the flat block was
# keyed to 0x40B7 (old PRO X SUPERLIGHT 2c) while the live PRO X2 SUPERSTRIKE
# is 0x40BD wireless / 0xC0A8 wired.
#
# Same file, upstream order: Keyboard, then Touchpad, then Pointer -- "A Touchpad
# is a Pointer, so we need to check for it before Pointer." The Touchpad block is
# therefore MANDATORY, not optional: without it a laptop trackpad inherits flat
# 1:1 accel and becomes unusable.
#
# PointerAccelerationProfile: 0 = none, 1 = flat, 2 = adaptive.
OVERRIDES = {
    "[Mouse]": {
        "cursorSize": "32",
    },
    "[Libinput][Defaults][Pointer]": {
        "PointerAcceleration": "0",
        "PointerAccelerationProfile": "1",
    },
    "[Libinput][Defaults][Touchpad]": {
        "PointerAccelerationProfile": "2",
    },
}

lines = sys.stdin.read().splitlines()

for section, keys in OVERRIDES.items():
    header = section
    section_idx = None
    next_section_idx = None
    for i, line in enumerate(lines):
        if line.strip() == header:
            section_idx = i
        elif section_idx is not None and line.strip().startswith("[") and i > section_idx:
            next_section_idx = i
            break

    if section_idx is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(header)
        for k, v in keys.items():
            lines.append(f"{k}={v}")
    else:
        insert_at = next_section_idx if next_section_idx else len(lines)
        for k, v in keys.items():
            found = False
            for i in range(section_idx + 1, insert_at):
                if lines[i].split("=")[0].strip() == k:
                    lines[i] = f"{k}={v}"
                    found = True
                    break
            if not found:
                lines.insert(insert_at, f"{k}={v}")
                insert_at += 1

print("\n".join(lines))
