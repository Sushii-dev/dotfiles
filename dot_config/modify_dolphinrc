#!/usr/bin/env python3
"""Merge view preferences into dolphinrc.

Reads existing dolphinrc from stdin, merges our overrides,
prints result to stdout. Dolphin manages most of this file —
we only enforce our display preferences.
"""
import sys

OVERRIDES = {
    "DetailsMode": {
        "ExpandableFolders": "false",
    },
    "General": {
        "GlobalViewProps": "false",
        "ViewMode": "1",
    },
}

existing = sys.stdin.read()
lines = existing.splitlines()
output = list(lines)

for section, keys in OVERRIDES.items():
    section_idx = None
    next_section_idx = None
    for i, line in enumerate(output):
        if line.strip() == f"[{section}]":
            section_idx = i
        elif section_idx is not None and line.strip().startswith("[") and i > section_idx:
            next_section_idx = i
            break

    if section_idx is None:
        output.append("")
        output.append(f"[{section}]")
        for k, v in keys.items():
            output.append(f"{k}={v}")
    else:
        insert_at = next_section_idx if next_section_idx else len(output)
        for k, v in keys.items():
            found = False
            for i in range(section_idx + 1, insert_at):
                if output[i].split("=")[0].strip() == k:
                    output[i] = f"{k}={v}"
                    found = True
                    break
            if not found:
                output.insert(insert_at, f"{k}={v}")
                insert_at += 1

print("\n".join(output))
