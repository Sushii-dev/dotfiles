#!/usr/bin/env python3
"""Ensure chezmoi-status plugin is enabled in DMS plugin settings.

Reads existing plugin_settings.json from stdin, merges required entries,
and prints the result. Preserves all existing plugin settings.
"""
import json
import sys

REQUIRED_PLUGINS = {
    "chezmoiStatus": {"enabled": True},
    "calendarMail": {"enabled": True},
}

existing = sys.stdin.read().strip()
data = json.loads(existing) if existing else {}

for plugin_id, defaults in REQUIRED_PLUGINS.items():
    if plugin_id not in data:
        data[plugin_id] = defaults

print(json.dumps(data, indent=2))
