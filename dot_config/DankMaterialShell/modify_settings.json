#!/usr/bin/env python3
"""Merge universal DMS preferences into settings.json.

Reads existing settings from stdin (chezmoi passes current file contents),
merges universal style/behavior keys from DEFAULTS, and prints the result.

Hardware-specific keys (monitors, audio devices, GPU indices) are EXCLUDED
so each machine keeps its own hardware config while sharing style, bar layout,
keybind-affecting settings, cursor, notifications, and all other preferences.
"""
import json
import sys

# Keys that are hardware/machine-specific — never overwrite these
EXCLUDE_KEYS = {
    # Monitor/display hardware
    "niriOutputSettings",
    "hyprlandOutputSettings",
    "screenPreferences",
    "showOnLastDisplay",
    "displayProfiles",
    "activeDisplayProfile",
    "lockScreenActiveMonitor",
    "desktopClockDisplayPreferences",
    "systemMonitorDisplayPreferences",
    "desktopWidgetPositions",
    "desktopWidgetGridSettings",
    # Audio/peripheral hardware
    "audioOutputDevicePins",
    "audioInputDevicePins",
    "brightnessDevicePins",
    "wifiNetworkPins",
    "bluetoothDevicePins",
    # GPU hardware
    "selectedGpuIndex",
    "enabledGpuPciIds",
    "systemMonitorGpuPciId",
    # Local state (not preferences)
    "browserUsageHistory",
    "filePickerUsageHistory",
}

