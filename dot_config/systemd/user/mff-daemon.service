[Unit]
Description=Mouse-follows-focus warp daemon for KDE (niri parity)
PartOf=graphical-session.target

[Service]
ExecCondition=/bin/sh -c '[ "$XDG_CURRENT_DESKTOP" = "KDE" ]'
ExecStart=/usr/bin/python3 /home/sushii/kde-dank/mff-daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=plasma-workspace.target
