[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = false
    syntax-theme = Coldark-Dark
    hyperlinks = true
    true-color = always

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default
    algorithm = histogram
